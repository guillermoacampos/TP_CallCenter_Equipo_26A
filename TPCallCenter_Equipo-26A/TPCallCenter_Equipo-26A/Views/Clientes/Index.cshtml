@model List<dominio.Clientes>

@{
    ViewBag.Title = "Gestión de Clientes";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3><i class="fas fa-users"></i> Gestión de Clientes</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-success">
                        <strong>¡Éxito!</strong> El controlador de Clientes está funcionando correctamente.
                    </div>
                    
                    <h4>Mensaje:</h4>
                    <p>@ViewBag.Message</p>
                    
                    <h4>Datos de prueba:</h4>
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre</th>
                                    <th>Apellido</th>
                                    <th>Email</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cliente in Model)
                                {
                                    <tr>
                                        <td>@cliente.IDCliente</td>
                                        <td>@cliente.Nombre</td>
                                        <td>@cliente.Apellido</td>
                                        <td>@cliente.Email</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="mt-3">
                        <a href="@Url.Action("Test", "Clientes")" class="btn btn-info">Probar acción Test</a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Volver al Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>