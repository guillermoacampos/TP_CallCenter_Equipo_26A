<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="TPCallCenter_Equipo_26A.Site1" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TP Call Center</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="Content/app-theme.css" />

    <style>
        :root {
            --brand-bg: #0f323c;
            --brand-accent: #1d4e58;
            --primary: #0d6efd;
            --danger: #dc3545;
            --card-radius: 14px;
            --card-border: #e5eaee;
            --text-dark: #0f323c;
            --text-muted: #5d6b73;
            --sidebar-bg: #0f323c;
        }
        html, body { height:100%; }
        body {
            margin:0;
            font-family:"Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: var(--text-dark);
            background-color:#0b1f24;
        }
        /* Fondo y overlay como en login */
        .global-bg {
            position:fixed; inset:0;
            background-image:url('https://images.unsplash.com/photo-1525182008055-f88b95ff7980?q=80&w=1600&auto=format&fit=crop');
            background-position:center;
            background-repeat:no-repeat;
            background-size:cover;
            filter:blur(2px);
            transform:scale(1.03);
            z-index:0;
        }
        .global-overlay {
            position:fixed; inset:0;
            background:linear-gradient(120deg, rgba(15,50,60,0.75), rgba(15,50,60,0.55));
            z-index:1;
        }
        .app-layout { position:relative; z-index:2; display:flex; min-height:100vh; }
        .app-sidebar {
            width:260px; flex:0 0 260px; background:var(--sidebar-bg); color:#fff;
            display:flex; flex-direction:column;
            border-right:1px solid rgba(255,255,255,0.08);
            backdrop-filter: blur(2px);
        }
        .app-sidebar .brand {
            padding:18px 22px; font-weight:800; font-size:1.25rem; letter-spacing:.5px;
            background:linear-gradient(120deg,var(--brand-bg),var(--brand-accent));
        }
        .app-sidebar a {
            color:#cfe8f0; text-decoration:none; padding:12px 22px; display:block;
            transition:background .15s, color .15s;
            font-size:.93rem;
        }
        .app-sidebar a:hover { background:rgba(255,255,255,0.10); color:#fff; }
        .sidebar-footer {
            margin-top:auto; padding:14px 22px;
            background:rgba(255,255,255,0.06);
            border-top:1px solid rgba(255,255,255,0.15);
        }
        .app-sidebar .btn-logout,
        .app-sidebar .btn-logout:focus,
        .app-sidebar .btn-logout:active {
            background-color: var(--danger) !important;
            border-color: var(--danger) !important;
            color:#fff !important;
            width:100%;
            border-radius:8px;
            font-weight:600;
        }
        .app-sidebar .btn-logout:hover {
            background-color:#bb2d3b !important;
            border-color:#b02a37 !important;
        }
        .app-content { flex:1 1 auto; display:flex; flex-direction:column; }
        .content-inner {
            padding:32px 40px;
            max-width:1400px;
            width:100%;
            margin:0 auto;
        }
        /* Tarjetas base reutilizables */
        .card-soft {
            background:#fff;
            border:1px solid var(--card-border);
            border-radius:var(--card-radius);
            box-shadow:0 12px 28px rgba(0,0,0,0.20);
            padding:20px 22px;
            position:relative;
            overflow:hidden;
        }
        .card-soft + .card-soft { margin-top:24px; }
        .kpi-grid {
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
            grid-gap:18px;
            margin-top:12px;
        }
        .kpi-box {
            background:#f8fafb;
            border:1px solid #e2e6ea;
            border-radius:12px;
            padding:14px 16px;
            text-align:center;
        }
        .kpi-label { font-size:.75rem; letter-spacing:.5px; color:#5b6b73; font-weight:600; text-transform:uppercase; }
        .kpi-value { font-size:1.6rem; font-weight:800; color:var(--text-dark); margin-top:4px; }
        .section-title { font-weight:700; font-size:1.1rem; margin:0 0 8px; color:var(--text-dark); }
        .quick-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:8px; }
        .quick-actions .btn { border-radius:8px; font-weight:600; }
        @media (max-width: 991.98px) {
            .app-sidebar { position:fixed; left:0; top:0; bottom:0; transform:translateX(-100%); transition:transform .2s; z-index:1040; }
            .app-sidebar.open { transform:translateX(0); }
            .sidebar-toggle { position:fixed; left:12px; top:12px; z-index:1050; }
            .content-inner { padding:24px 24px; }
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <div class="global-bg"></div>
    <div class="global-overlay"></div>

    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>

        <button type="button" class="btn btn-outline-light d-lg-none sidebar-toggle"
                onclick="document.getElementById('sidebarWrapper').classList.toggle('open')">☰</button>

        <div class="app-layout">
            <div id="sidebarWrapper" runat="server" class="app-sidebar">
                <div class="brand">CALL CENTER</div>
                <a href="Default.aspx">Inicio</a>
                <a href="GestionIncidentes.aspx">Incidencias</a>
                <a href="Clientes.aspx">Clientes</a>
                <asp:PlaceHolder ID="phGestionUsuarios" runat="server">
                    <a href="Usuarios.aspx">Usuarios</a>
                    <a href="Reportes.aspx">Reportes</a>
                </asp:PlaceHolder>
                <div class="sidebar-footer">
                    <asp:Button ID="btnLogout" runat="server" CssClass="btn btn-sm btn-logout" Text="Cerrar sesión" OnClick="Logout_Click" />
                </div>
            </div>

            <div class="app-content">
                <div class="content-inner">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
                </div>
            </div>
        </div>

        <script src="https://code.jquery.com/jquery-3.6.0.min.js" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    </form>
</body>
</html>