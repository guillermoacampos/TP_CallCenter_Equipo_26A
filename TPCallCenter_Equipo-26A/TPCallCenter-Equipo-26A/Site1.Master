<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.Master.cs" Inherits="TPCallCenter_Equipo_26A.Site1" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server" /></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
    <style>
        html, body, #wrapper {
            height: 100%;
            margin: 0;
        }
        #sidebar-wrapper {
            height: 100%;
            position: fixed;
            top: 0;
            left: 0;
            overflow-y: auto;
            width: 250px;
            background-color: #343a40;
        }
        #sidebar-wrapper .sidebar-heading {
            font-size: 1.5rem;
            font-weight: bold;
            color: white;
            text-align: center;
            padding: 20px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        #sidebar-wrapper .list-group-item {
            border: none;
            padding: 10px 20px;
        }
        #sidebar-wrapper .list-group-item:not(:last-child) {
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        #sidebar-wrapper .list-group-item-action {
            color: white;
        }
        #sidebar-wrapper .list-group-item-action:hover {
            background-color: #495057;
        }
        #sidebar-wrapper .logout {
            margin-top: auto;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            text-align: center;
            padding: 15px 0;
        }
        #sidebar-wrapper .logout a {
            color: #dc3545;
            font-weight: bold;
        }
        #sidebar-wrapper .logout a:hover {
            color: #bd2130;
        }
        #page-content-wrapper {
            margin-left: 250px;
            width: calc(100% - 250px);
            height: 100%;
            overflow-y: auto;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <div class="d-flex" id="wrapper">
            <!-- Sidebar -->
            <div class="bg-dark border-right d-flex flex-column" id="sidebar-wrapper">
                <div class="sidebar-heading">Call Center</div>
                <div class="list-group list-group-flush">
                    <a href="Default.aspx" class="list-group-item list-group-item-action bg-dark text-white">
                        <i class="fas fa-tachometer-alt"></i> Dashboard
                    </a>
                    <a href="Clientes.aspx" class="list-group-item list-group-item-action bg-dark text-white">
                        <i class="fas fa-users"></i> Clientes
                    </a>
                    <a href="GestionIncidentes.aspx" class="list-group-item list-group-item-action bg-dark text-white">
                        <i class="fas fa-exclamation-circle"></i> Gestión de Incidentes
                    </a>
                    <a href="#" class="list-group-item list-group-item-action bg-dark text-white">
                        <i class="fas fa-chart-bar"></i> Reportes
                    </a>
                </div>
                <div class="logout">
                    <a href="Logout.aspx">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </a>
                </div>
            </div>
            <!-- /#sidebar-wrapper -->

            <!-- Page Content -->
            <div id="page-content-wrapper">
                <div class="container-fluid">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
                </div>
            </div>
            <!-- /#page-content-wrapper -->
        </div>
        <!-- /#wrapper -->

        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    </form>
</body>
</html>
