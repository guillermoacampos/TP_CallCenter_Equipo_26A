<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.Master.cs" Inherits="TPCallCenter_Equipo_26A.Site1" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server" /></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
    <style>
        html, body, #wrapper {
            height: 100%;
            margin: 0;
        }
        #sidebar-wrapper {
            height: 100%;
            position: fixed;
            top: 0;
            left: 0;
            overflow-y: auto;
            width: 250px;
        }
        #page-content-wrapper {
            margin-left: 250px;
            width: calc(100% - 250px);
            height: 100%;
            overflow-y: auto;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <div class="d-flex" id="wrapper">
            <!-- Sidebar -->
            <div class="bg-dark border-right" id="sidebar-wrapper">
                <div class="sidebar-heading text-white">Call Center</div>
                <div class="list-group list-group-flush">
                    <a href="Default.aspx" class="list-group-item list-group-item-action bg-dark text-white">
                        <i class="fas fa-tachometer-alt"></i> Dashboard
                    </a>
                    <a href="Clientes.aspx" class="list-group-item list-group-item-action bg-dark text-white">
                        <i class="fas fa-users"></i> Clientes
                    </a>
                    <a href="#" class="list-group-item list-group-item-action bg-dark text-white">
                        <i class="fas fa-chart-bar"></i> Reportes
                    </a>
                    <a href="#" class="list-group-item list-group-item-action bg-dark text-white">
                        <i class="fas fa-cog"></i> Configuración
                    </a>
                </div>
            </div>
            <!-- /#sidebar-wrapper -->

            <!-- Page Content -->
            <div id="page-content-wrapper">
                <div class="container-fluid">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
                </div>
            </div>
            <!-- /#page-content-wrapper -->
        </div>
        <!-- /#wrapper -->

        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    </form>
</body>
</html>
