<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Externalizar connectionStrings en archivo local (connectionStrings.config).
       Cada desarrollador mantiene su propia versión local y NO la hace commit. -->
  <connectionStrings configSource="connectionStrings.config" />

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>

  <!-- Mantener el resto de tu Web.config (authentication, appSettings, etc.) -->
</configuration>